# ===== Isi nilai di bawah, lalu simpan file ini =====
# File ini sudah ada di .gitignore, jadi tidak ikut ke GitHub.

# ===== Situs =====
APP_URL=http://localhost:3000

# ===== Pterodactyl (Application API / plta) =====
# Buat di Admin Area → Application API → Create New
PTERO_URL=https://panel.domainkamu.com
PTERO_API_KEY=ptla_ISI_TOKEN_DISINI
PTERO_LOCATION_ID=1
PTERO_EGG_ID=5
PTERO_DOCKER_IMAGE=ghcr.io/pterodactyl/yolks:java_17
PTERO_STARTUP=java -Xms128M -Xmx{{SERVER_MEMORY}}M -jar {{SERVER_JARFILE}}
PTERO_ENVIRONMENT={}

# Dipakai untuk endpoint admin /api/provision
ADMIN_SECRET=ganti-dengan-string-acak-panjang

# ===== Kasera Pay =====
# Pakai kp_test_ untuk uji coba, kp_live_ saat go-live
KASERA_API_KEY=kp_test_ISI_DISINI
KASERA_WEBHOOK_SECRET=ISI_SIGNING_SECRET_DISINI

# ===== Upstash Redis (penyimpanan order) =====
UPSTASH_REDIS_REST_URL=ISI_REST_URL_DISINI
UPSTASH_REDIS_REST_TOKEN=ISI_TOKEN_DISINI

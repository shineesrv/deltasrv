# ===== Situs =====
# URL publik website (tanpa slash di akhir)
APP_URL=https://website-kamu.vercel.app

# ===== Pterodactyl (Application API) =====
# URL panel, contoh: https://panel.domainkamu.com
PTERO_URL=
# Application API key (ptla_...) dengan izin read & write
PTERO_API_KEY=
# ID location tempat server dibuat
PTERO_LOCATION_ID=1
# ID egg yang dijual
PTERO_EGG_ID=5
# Docker image dan startup command sesuai egg
PTERO_DOCKER_IMAGE=ghcr.io/pterodactyl/yolks:java_17
PTERO_STARTUP=java -Xms128M -Xmx{{SERVER_MEMORY}}M -jar {{SERVER_JARFILE}}
# Environment variable egg dalam format JSON, contoh: {"SERVER_JARFILE":"server.jar"}
PTERO_ENVIRONMENT={}

# Dipakai untuk endpoint admin /api/provision (pengiriman manual)
ADMIN_SECRET=ganti-dengan-string-acak-panjang

# ===== Kasera Pay =====
# Gunakan kp_test_... untuk uji coba, kp_live_... saat go-live
KASERA_API_KEY=
# Signing secret endpoint webhook (mode yang sama dengan API key)
KASERA_WEBHOOK_SECRET=

# ===== Penyimpanan order (Upstash Redis, wajib di produksi) =====
# Buat database gratis di upstash.com, lalu salin REST URL dan token
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
